[Unit]
Description=TradingBot Live Server
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/TradingBot
ExecStart=/home/%i/TradingBot/bin/live.sh

# Defaults are in bin/live.sh — override here only if needed

Restart=on-failure
RestartSec=5

# Logging — viewable via: journalctl -u tradingbot -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
